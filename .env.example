# Copy to .env for `docker compose`. Everything is optional.
# Match your host user so files in the bind mounts are yours (`id -u`, `id -g`).
# UID is a read-only variable in bash, so export it from your shell rc or set it here:
UID=1000
GID=1000
# Host port the UI is served on.
STEMCRAFT_PORT=8000
# Host directories for the database, songs and albums.
STEMCRAFT_DATA=./data
STEMCRAFT_SONGS=./songs
STEMCRAFT_ALBUMS=./albums
# Set to 1 to skip the yt-dlp self-update at container start.
STEMCRAFT_SKIP_YTDLP_UPDATE=0
